{
  "name": "@pdm/catalogue",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook: every shared component (packages/ui, packages/charts) in each state and theme, with checks.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev --port 6006 --no-open",
    "build:storybook": "storybook build --output-dir storybook-static --quiet",
    "test:stories": "npm run build:storybook && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pdm/charts": "*",
    "@pdm/ui": "*",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "storybook": "10.6.5"
  }
}
