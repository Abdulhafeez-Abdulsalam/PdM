{
  "name": "@pdm/web",
  "version": "0.1.0",
  "private": true,
  "description": "The PdM web application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:connected": "vite build --mode server --outDir dist-server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:server": "playwright test --config playwright.server.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pdm/api-client": "*",
    "@pdm/charts": "*",
    "@pdm/contracts": "*",
    "@pdm/mock-data": "*",
    "@pdm/ui": "*",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-virtual": "3.14.21",
    "get-nonce": "^1.0.1",
    "i18next": "^26.4.3",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.16",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.14.0"
  }
}
