{
  "name": "@pdm/server",
  "version": "0.1.0",
  "private": true,
  "description": "The PdM server: answers every endpoint in @pdm/contracts over HTTP and pushes live values over a WebSocket, running one shared plant simulation (Phase 5, ADR-0012, ADR-0013).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/websocket": "11.3.4",
    "@pdm/contracts": "*",
    "@pdm/mock-data": "*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@pdm/api-client": "*",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15"
  }
}
