{
  "name": "pdm-platform",
  "private": true,
  "description": "Predictive Maintenance platform frontend (monorepo root)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "npm run dev -w @pdm/web",
    "dev:server": "npm run dev -w @pdm/server",
    "start:server": "npm start -w @pdm/server",
    "dev:connected": "npm run dev -w @pdm/web -- --mode server",
    "start": "npm run build:connected -w @pdm/web && npm run start:server",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . && turbo run typecheck lint test --concurrency=50%",
    "test:watch": "npm run test:watch -w @pdm/web",
    "prepare": "husky",
    "e2e": "npm run e2e --workspace @pdm/web",
    "e2e:server": "npm run e2e:server --workspace @pdm/web"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,json,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "playwright-core": "1.63.0",
    "ws": "8.22.0"
  }
}
