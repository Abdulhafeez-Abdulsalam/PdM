# Dependencies (re-created by `npm install`)
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
.turbo/

# Test and tool output
coverage/
playwright-report/
test-results/
storybook-static/

# Local environment files (may contain secrets — never commit)
.env
.env.*
!.env.example

# The server's database (people's work and sessions; Phase 5, ADR-0015)
apps/server/data/

# Logs
*.log
npm-debug.log*

# Editor and OS clutter
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
